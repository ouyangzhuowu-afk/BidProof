{
  "name": "bidproof-frontend",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:js && node scripts/stamp-assets.mjs",
    "build:js": "vite build",
    "build:css": "node scripts/build-css.mjs",
    "dev": "vite build --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "verify": "npm run check && npm run check:boundaries && npm test && npm run build && npm run lint",
    "check:boundaries": "tsc -p tsconfig.boundaries.json --noEmit",
    "test": "node --test scripts/test-*.mjs"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.0"
  }
}
