{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bidproof-marketcase",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "routes": [
    { "pattern": "bidproof.marketcase.net/*", "zone_name": "marketcase.net" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "containers": [
    {
      "class_name": "BidProofContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BIDPROOF", "class_name": "BidProofContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BidProofContainer"] }
  ]
}
