# Copy to .env.production; fill every blank. Do not commit the filled file.
# A real domain and DNS pointing to your host are required before starting Caddy.
BIDPROOF_DOMAIN=
BIDPROOF_PUBLIC_ORIGIN=
ACME_EMAIL=
# Set this to the actual deployment region; do not invent a residency promise.
BIDPROOF_DATA_REGION=deployment-defined
# Generate each separately with: openssl rand -hex 32
# Hex avoids SQL connection-URL escaping ambiguity.
POSTGRES_PASSWORD=
BIDPROOF_BOOTSTRAP_TOKEN=
BIDPROOF_FIELD_ENCRYPTION_KEY=
# Invite-only by default. Change deliberately when a signup/abuse policy is in place.
BIDPROOF_PERSONAL_SIGNUP=0
BIDPROOF_IMAGE_TAG=production-local
# Change subnet and IP together if this range overlaps another local network.
BIDPROOF_PROXY_SUBNET=172.30.64.0/29
BIDPROOF_PROXY_IP=172.30.64.2
