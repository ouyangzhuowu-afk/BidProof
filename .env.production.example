# Copy to .env.production; fill every blank. Do not commit the filled file.
# A real domain and DNS pointing to your host are required before starting Caddy.
BIDPROOF_DOMAIN=
BIDPROOF_PUBLIC_ORIGIN=
ACME_EMAIL=
# Set this to the actual deployment region; do not invent a residency promise.
BIDPROOF_DATA_REGION=deployment-defined
# Generate each separately with: openssl rand -hex 32
# Hex avoids SQL connection-URL escaping ambiguity.
POSTGRES_PASSWORD=
BIDPROOF_BOOTSTRAP_TOKEN=
BIDPROOF_FIELD_ENCRYPTION_KEY=
# Invite-only by default. Change deliberately when a signup/abuse policy is in place.
BIDPROOF_PERSONAL_SIGNUP=0
BIDPROOF_IMAGE_TAG=production-local
# Change subnet and IP together if this range overlaps another local network.
BIDPROOF_PROXY_SUBNET=172.30.64.0/29
BIDPROOF_PROXY_IP=172.30.64.2

# Passwordless login: configure only the channels you actually use.
# Render Free blocks outbound SMTP 25/465/587; use the HTTPS Resend adapter there.
# See docs/production/passwordless-auth-2026-09-24.md for callbacks and verification.
BIDPROOF_OTP_SECRET=
BIDPROOF_EMAIL_PROVIDER=resend
BIDPROOF_RESEND_API_KEY=
BIDPROOF_EMAIL_FROM=
# Alternative for SMTP-capable deployments: EMAIL_PROVIDER=smtp with TLS.
BIDPROOF_SMTP_HOST=
BIDPROOF_SMTP_PORT=587
BIDPROOF_SMTP_SECURITY=starttls
BIDPROOF_SMTP_FROM=
BIDPROOF_SMTP_USERNAME=
BIDPROOF_SMTP_PASSWORD=
BIDPROOF_TWILIO_ACCOUNT_SID=
BIDPROOF_TWILIO_AUTH_TOKEN=
BIDPROOF_TWILIO_FROM=
# Explicit destination-country allowlist, e.g. +86; blank disables SMS.
BIDPROOF_SMS_ALLOWED_PREFIXES=
BIDPROOF_GOOGLE_CLIENT_ID=
BIDPROOF_GOOGLE_CLIENT_SECRET=
BIDPROOF_GITHUB_CLIENT_ID=
BIDPROOF_GITHUB_CLIENT_SECRET=
